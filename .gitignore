# ----------------------------------------------------------------------
# Third-party / External build artifacts
# ----------------------------------------------------------------------
# If you compile mplayer or other external libs in-tree, ignore their 
# configuration and output files (if they aren't git submodules)
external/mplayer/config.mak
external/mplayer/config.h
external/mplayer/ffmpeg/config.mak
external/mplayer/ffmpeg/config.h

# Empty portlibs shim (system portlibs come from dkp-pacman, see Dockerfile)
external/portlibs/

# Generated CSS parser/lexer (regenerate via flex/bison)
src/html_parser/css_lex.c
src/html_parser/css_lex.h
src/html_parser/css_syntax.c
src/html_parser/css_syntax.h

# Legacy libs/ vendored binaries (migrated to portlibs via dkp-pacman)
libs/

# ----------------------------------------------------------------------
# Vendored libiconv build artifacts (never commit; use portlibs via dkp-pacman)
# ----------------------------------------------------------------------
# Generated by running libiconv's configure in-tree (absolute /tmp/rebuild
# paths, host-specific). Purged from history; do not re-add.
/libcharset/
/srclib/
src/Makefile
man/Makefile
/libtool
/stamp-h1
include/iconv.h
include/iconv.h.inst

# Distribution / packaging
dist/
artifacts/
*.zip
*.7z

